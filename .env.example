# Local development: no secrets required.
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=local
NEXT_PUBLIC_KEYSTATIC_GITHUB_OWNER=
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Production: choose github above and complete the official GitHub App setup.
# These are SERVER-ONLY. Never prefix secrets with NEXT_PUBLIC_.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
